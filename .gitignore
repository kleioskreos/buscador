# Semilla de datos (regenerable con `python scripts/export_tsv.py` desde el .xlsb)
# El .tsv pesa ~160 MB y excede el límite de 100 MB de GitHub.
db/seed/btr_data.tsv

# Secretos locales (usar .env.example como plantilla)
.env

# Copias temporales del archivo base BTR para conversion (no commitear)
BTR_202604.xlsx
BTR_202604_local.xlsb
BTR_202604_clean.xlsx

# Builds de PyInstaller (solo se commitea el .zip distribuible final, NO los
# artefactos intermedios). Regenerar con:
#   python -m PyInstaller --onedir --console --name xlsb_to_tsv \
#     --noconfirm --distpath dist scripts/xlsb_to_tsv.py
#   Compress-Archive -Path dist/xlsb_to_tsv -DestinationPath dist/xlsb_to_tsv_v1.zip
build/
xlsb_to_tsv.spec
__pycache__/
*.pyc
dist/*.exe
dist/xlsb_to_tsv/   # carpeta onedir

