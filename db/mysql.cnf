[mysqld]
# ---------- Full-Text Search ----------
# Permite busquedas por prefijo desde 2 caracteres (ej. "HU*" -> HUAMAN, HUAMANGA)
innodb_ft_min_token_size=2
innodb_ft_max_token_size=84
# Desactivar stopwords para que terminos como "LA", "DE" (comunes en UGEL LA MAR) sean buscables
innodb_ft_enable_stopword=OFF
ft_min_word_len=2

# ---------- Carga de datos ----------
# Directorio permitido para LOAD DATA INFILE
secure_file_priv=/var/lib/mysql-files
local_infile=1
max_allowed_packet=512M

# ---------- Rendimiento ----------
innodb_buffer_pool_size=1G
innodb_flush_log_at_trx_commit=0
innodb_log_file_size=512M
innodb_log_buffer_size=64M
sync_binlog=0
skip-log-bin
tmp_table_size=256M
max_heap_table_size=256M
sort_buffer_size=8M
read_buffer_size=4M

# ---------- Conexiones ----------
max_connections=200
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
default-time-zone=+00:00

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4